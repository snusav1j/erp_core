.modal.fade#versions-modal
  .modal-dialog.modal-auto
    .modal-content
      .modal-header
        %h4.modal-title= title
        %button.close{ "aria-label" => "Close", "data-dismiss" => "modal", "type" => "button" }
          %span{ "aria-hidden" => "true" }= ph_icon('x')

      .modal-body
        - if @versions.present?
          = render partial: '/versions/table', locals: { versions: @versions }
        - else
        
          .text-center.text-muted= tgm(:no_changes)
      .modal-footer
        %button.btn.btn-default.pull-right{ "data-dismiss" => "modal", type: "button" }= tgm(:close)