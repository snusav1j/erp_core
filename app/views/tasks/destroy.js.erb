<% if @destroyed %>
  <% tasks_count = current_user.active_tasks_count %>

  <% if tasks_count > 0 %>
    $('.current_user_active_tasks_count').html('<%= tasks_count %>')
    $('.current_user_active_tasks_count').show()
  <% else %>
    $('.current_user_active_tasks_count').hide()
  <% end %>

  <% if @task.parent.present? %>
    
    $("#subtasks-table").html("<%= j @task.parent.subtasks.where.not(id: @task.id).order(created_at: :asc).map { |subtask| render(partial: '/tasks/kanban_task', locals: { task: subtask, subtask: true }) }.join.html_safe %>");
    $("#subtask-modal .modal-title .text-muted").html("<%= @task.parent.subtask_progress %>");
  <% end %>
  $("#tasks-table").html("<%= j render partial: '/tasks/kanban', locals: { tasks: @tasks_by_status } %>");
  toastr.warning({description: "<%= tm(Task, :task_destroyed) %>", life_time: 2000})
<% else %>
  <%= toastr_flash() %>
<% end %>