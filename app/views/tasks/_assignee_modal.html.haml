.modal.fade#task-modal
  .modal-dialog.modal-auto
    .modal-content
      .modal-header
        %h4.modal-title= title
        %button.close{ "aria-label" => "Close", "data-dismiss" => "modal", "type" => "button" }
          %span{"aria-hidden" => "true"}= ph_icon('x')
      .modal-body
        = render partial: '/tasks/assignee_form'
      .modal-footer
        %button.btn.btn-default.pull-left{"data-dismiss" => "modal", :type => "button"}= tgm(:cancel)
        %button.btn.btn-primary.pull-right{:type => "submit", form: 'task-assignee-form', data: { disable_with: "#{tgm(:adding)} #{disable_with_icon}".html_safe }}
          = tgm(:add)