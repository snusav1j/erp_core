<% if @created %>
  $("#tasks-table").html("<%= j render partial: '/tasks/kanban', locals: { tasks: @tasks_by_status } %>");

  $('#task-modal').modal('hide');

  toastr.success({description: "<%= tm(Task, :task_created) %>", life_time: 2000})

<% else %>

  <%= toastr_flash() %>

<% end %>