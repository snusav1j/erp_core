        .custom-toastr-content
          .custom-toastr-message
          .custom-toastr-description.text-muted.text-small
      = ph_fill_icon(:pause_circle, 'progress-pause-timer')
      = ph_fill_icon(:x_circle, 'close-icon')
    .custom-toastr-details